{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/agent_safety.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.agents\\hooks\\agent_safety.py\"",
            "timeout": 2,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/agent_safety.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.agents\\hooks\\agent_safety.py\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
